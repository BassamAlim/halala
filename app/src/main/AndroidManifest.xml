<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BiometricPrompt on every cold start, with device credential as the fallback. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Bank SMS: each one as it arrives, and the inbox once for the back-import. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!--
        Groq over HTTPS (a merchant's name to identify it, a question you ask the assistant),
        public gold and fund prices, and the spending map's tiles. Nothing of your ledger is sent.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Only while "Remember where you spend" is on: where the phone is when a purchase's SMS
        arrives (so in the background too). Kept in the encrypted ledger, never sent.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- The review reminder, and nothing per transaction. Asked for when you turn the reminder on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        No Android backup at all: the database is encrypted with a key that never leaves this
        phone's Keystore, so a copy restored elsewhere could never be opened. Halala's own
        export (and, later, its encrypted .halala backup) is the way data moves.
    -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Halala"
        tools:targetApi="31">
        <activity
            android:name=".core.Activity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Halala"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only the system can send SMS_RECEIVED (BROADCAST_SMS is a system permission). -->
        <receiver
            android:name=".core.sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- The reminder notification's "In 1 hour" and "Tomorrow". -->
        <receiver
            android:name=".core.reminders.ReviewReminders$SnoozeReceiver"
            android:exported="false" />

        <!-- The home-screen widget (Glance). -->
        <receiver
            android:name=".core.widget.HalalaWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/halala_widget" />
        </receiver>

        <!-- WorkManager is configured by App (it supplies Hilt's worker factory). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
